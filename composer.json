{
    "name": "marijnworks/zoom-roulette",
    "description": "A bot to set up random zoom meetings for smalltalk.",
    "type": "project",
    "config": {
        "platform": {
            "php": "8.5"
        }
    },
    "require": {
        "slim/slim": "^4.5",
        "guzzlehttp/psr7": "^3.2",
        "monolog/monolog": "^3.0",
        "league/container": "^5.0",
        "league/oauth2-client": "^2.9.1",
        "slim/twig-view": "^3.1",
        "bryanjhv/slim-session": "^4.0",
        "doctrine/dbal": "^4.0",
        "ext-json": "*",
        "ext-pdo": "*",
        "ramsey/uuid": "^4.1",
        "defuse/php-encryption": "^2.3",
        "guzzlehttp/guzzle": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Marijnworks\\Zoomroulette\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Marijnworks\\Zoomroulette\\": "tests/"
        }
    },
    "license": "MIT",
    "require-dev": {
        "phpstan/phpstan": "^2.3"
    }
}
